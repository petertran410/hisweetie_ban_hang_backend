/// Phiếu ký gửi (gửi hàng tại kho/điểm bán của khách).
/// B1: tạo phiếu (PENDING/CONFIRMED) — không trừ kho, không tính công nợ.
/// B2: xử lý kho (PACKED/LOADING/DELIVERED) — trừ kho thật tại PACKED.
/// B3: xuất hóa đơn (1 phiếu : N hóa đơn) — lúc này mới tính công nợ.
/// Số đã xuất hóa đơn KHÔNG lưu cột riêng; luôn derive từ các invoice con.
model Consignment {
  id            Int      @id @default(autoincrement())
  code          String   @unique
  customerId    Int?
  branchId      Int?
  soldById      Int?
  saleChannelId Int?
  priceBookId   Int?
  priceBookName String?
  consignDate   DateTime @default(now())
  totalAmount   Decimal  @default(0)
  discount      Decimal  @default(0)
  discountRatio Decimal  @default(0)
  grandTotal    Decimal  @default(0)
  status        Int      @default(1)
  statusValue   String?
  consignStatus String   @default("pending")
  toComplete    Boolean  @default(false)
  description   String?
  createdBy     Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  customer    Customer?         @relation(fields: [customerId], references: [id])
  branch      Branch?           @relation(fields: [branchId], references: [id])
  soldBy      User?             @relation("ConsignmentSeller", fields: [soldById], references: [id])
  saleChannel SaleChannel?      @relation(fields: [saleChannelId], references: [id])
  creator     User              @relation("ConsignmentCreator", fields: [createdBy], references: [id])
  priceBook   PriceBook?        @relation("ConsignmentPriceBook", fields: [priceBookId], references: [id])
  items       ConsignmentItem[]
  invoices    Invoice[]
  delivery    ConsignmentDelivery?
  packingSlips    PackingSlipInvoice[]
  packingHangs    PackingHangInvoice[]
  packingLoadings PackingLoadingInvoice[]
  returns         ConsignmentReturn[]

  @@map("consignments")
}

model ConsignmentItem {
  id            Int      @id @default(autoincrement())
  consignmentId Int
  productId     Int
  productCode   String
  productName   String
  quantity      Decimal  @default(0) @db.Decimal(18, 4)
  price         Decimal  @default(0) @db.Decimal(18, 2)
  discount      Decimal  @default(0) @db.Decimal(18, 2)
  discountRatio Decimal  @default(0) @db.Decimal(18, 4)
  totalPrice    Decimal  @default(0) @db.Decimal(18, 2)
  note          String?
  manufactureDate DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  consignment Consignment @relation(fields: [consignmentId], references: [id], onDelete: Cascade)
  product     Product     @relation(fields: [productId], references: [id])

  @@unique([consignmentId, productId])
  @@map("consignment_items")
}

model ConsignmentDelivery {
  id            Int       @id @default(autoincrement())
  consignmentId Int       @unique
  receiver      String
  contactNumber String
  address       String
  locationName  String?
  wardName      String?
  weight        Decimal?
  weightUnit    String?   @default("g")
  length        Decimal?
  width         Decimal?
  height        Decimal?
  noteForDriver String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  consignment Consignment @relation(fields: [consignmentId], references: [id], onDelete: Cascade)

  @@map("consignment_deliveries")
}

/// Hoàn hàng ký gửi — khách trả lại hàng đã ký gửi (chưa xuất hóa đơn).
/// Luồng 2 bước: REQUEST (1) -> STOCK_RECEIVED (2, hoàn kho). CANCELLED (5).
/// Không phát sinh công nợ/hoàn tiền (ký gửi B1/B2 chưa có nợ).
model ConsignmentReturn {
  id              Int      @id @default(autoincrement())
  code            String   @unique
  consignmentId   Int
  consignmentCode String
  customerId      Int?
  branchId        Int
  status          Int      @default(1)
  statusValue     String?
  totalReturnQuantity Decimal @default(0) @db.Decimal(18, 4)
  note            String?
  receivedById    Int?
  createdBy       Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  consignment Consignment              @relation(fields: [consignmentId], references: [id])
  customer    Customer?                @relation("ConsignmentReturnCustomer", fields: [customerId], references: [id])
  branch      Branch                   @relation(fields: [branchId], references: [id])
  details     ConsignmentReturnDetail[]

  @@index([consignmentId])
  @@index([customerId])
  @@index([branchId])
  @@index([status])
  @@map("consignment_returns")
}

model ConsignmentReturnDetail {
  id                Int     @id @default(autoincrement())
  consignmentReturnId Int
  productId         Int
  productCode       String
  productName       String
  consignedQuantity Decimal @default(0) @db.Decimal(18, 4)
  returnQuantity    Decimal @default(0) @db.Decimal(18, 4)
  goodQuantity      Decimal @default(0) @db.Decimal(18, 4)
  damagedQuantity   Decimal @default(0) @db.Decimal(18, 4)
  nearExpiryQuantity Decimal @default(0) @db.Decimal(18, 4)
  manufactureDate   DateTime?
  note              String?

  consignmentReturn ConsignmentReturn @relation(fields: [consignmentReturnId], references: [id], onDelete: Cascade)
  product           Product           @relation(fields: [productId], references: [id])

  @@index([consignmentReturnId])
  @@map("consignment_return_details")
}

