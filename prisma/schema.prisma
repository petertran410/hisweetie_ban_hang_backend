model Notification {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  type      String
  title     String
  body      String?
  /// Dữ liệu kèm theo (txId, referenceNumber, amountIn, ...). Dùng để render.
  data      Json?
  /// Deep-link dựng sẵn để điều hướng khi click.
  link      String?
  /// Khóa chống trùng trong cùng (userId, type) — vd sepayId. Sepay retry
  /// webhook nhiều lần cũng không tạo thông báo lặp.
  dedupeKey String?   @map("dedupe_key")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, dedupeKey])
  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

/// Hợp đồng ký điện tử qua Documenso. Bảng proxy: lưu trạng thái + tham chiếu
/// envelope bên Documenso, không lưu nội dung PDF (PDF đã ký tải về uploads/contracts/).
model Contract {
  id                 Int       @id @default(autoincrement())
  customerId         Int       @map("customer_id")
  title              String
  /// Nguồn tạo: "template" (từ template Documenso) | "upload" (PDF tải lên)
  source             String    @default("template")
  /// Envelope id bên Documenso (vd "envelope_abc123"). Unique để webhook map ngược.
  documensoId        String?   @unique @map("documenso_id")
  recipientEmail     String?   @map("recipient_email")
  /// Trạng thái: DRAFT | SENT | PARTIALLY_SIGNED | SIGNED | REJECTED | EXPIRED | CANCELLED
  /// - SENT: đã gửi bản ký (Documenso) cho khách hoặc NV (tuỳ thứ tự).
  /// - PARTIALLY_SIGNED: HĐ 2 bên, 1 bên đã ký, đang chờ bên còn lại.
  /// - SIGNED: tất cả bên đã ký xong (PDF hoàn tất, đã niêm phong số).
  status             String    @default("DRAFT")
  /// Link ký Documenso trả về khi distribute (để mở lại / gửi cho khách).
  signingUrl         String?   @map("signing_url")
  /// Đường dẫn PDF đã ký tải về (vd /uploads/contracts/xxx.pdf).
  signedFileUrl      String?   @map("signed_file_url")
  /// Lý do từ chối nếu khách reject.
  rejectReason       String?   @map("reject_reason")
  sentAt             DateTime? @map("sent_at")
  signedAt           DateTime? @map("signed_at")
  createdBy          Int?      @map("created_by")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  /// externalId mình tự sinh khi tạo document (vd "contract-cus12-169..."). Webhook
  /// Documenso trả lại externalId → dùng làm khóa map chính (ổn định nhất).
  externalId         String?   @unique @map("external_id")
  /// Template Documenso đã dùng (loại hợp đồng). Null nếu upload PDF.
  templateId         Int?      @map("template_id")
  templateTitle      String?   @map("template_title")
  /// Loại HĐ: SINGLE (1 bên ký) | DOUBLE (2 bên ký tuần tự). Phát hiện theo
  /// số recipient SIGNER trong template Documenso.
  contractType       String    @default("SINGLE") @map("contract_type")
  /// Email Documenso user cho "BÊN A" (NV công ty). Mặc định env CONTRACT_SIGNER_EMAIL.
  companySignerEmail String?   @map("company_signer_email")
  creator            User?     @relation("ContractCreator", fields: [createdBy], references: [id])
  customer           Customer  @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@index([status])
  @@map("contracts")
}

/// Cache mapping Documenso user (email) ↔ phòng ban / vai trò ký BÊN A. Mỗi
/// dòng ứng với 1 user Documenso được phép ký thay công ty. POS không quản lý
/// chữ ký ở đây — Documenso tự apply personalSignature của user khi ký.
model ContractSigner {
  id             Int       @id @default(autoincrement())
  /// Email của Documenso user (dùng làm recipient email khi tạo envelope).
  documensoEmail String    @unique @map("documenso_email")
  name           String?
  /// Phòng ban / vai trò (vd "Phòng Sale", "Phòng Kế toán", "Ban GĐ").
  department     String?
  /// Mã nội bộ (vd "sale", "accounting", "director") — tiện cho filter/seed.
  code           String?   @unique
  isActive       Boolean   @default(true) @map("is_active")
  lastSyncedAt   DateTime? @map("last_synced_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([department])
  @@map("contract_signers")
}

/// Cache tỉ giá ngoại tệ. Dùng để cache response từ fxratesapi.com (hoặc
/// nguồn khác) — tránh gọi API quá nhiều lần. Mỗi cặp (base, target) chỉ
/// giữ 1 dòng; `fetchedAt` để ExchangeRateService quyết định có cần refresh
