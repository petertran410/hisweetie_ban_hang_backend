  orderSupplierId      Int
  productId            Int
  productCode          String
  productName          String
  quantity             Decimal
  price                Decimal
  discount             Decimal                       @default(0)
  allocation           Decimal                       @default(0)
  allocationSuppliers  Decimal                       @default(0)
  allocationThirdParty Decimal                       @default(0)
  orderQuantity        Decimal                       @default(0)
  subTotal             Decimal
