  statusValue         String?
  branchId            Int? // chi nhánh nhận hàng (đích)
  borderGateId        Int? // cửa khẩu (master data, có thể thêm/sửa)
  vehicleInfo         String? // số hợp đồng (label FE: "Số hợp đồng")
  files               Json? // danh sách file đính kèm: [{ filename, url, size, mimetype, originalname }]
  expectedArrivalDate DateTime? // ngày dự kiến xe về kho
  actualArrivalDate   DateTime? // ngày xe về kho thực tế (set khi createPurchaseOrders)
  description         String?
  createdBy           Int
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  branch         Branch?               @relation(fields: [branchId], references: [id])
  borderGate     BorderGate?           @relation(fields: [borderGateId], references: [id])
  creator        User                  @relation("VehicleShipmentCreator", fields: [createdBy], references: [id])
  items          VehicleShipmentItem[]
  purchaseOrders PurchaseOrder[]

  @@map("vehicle_shipments")
