  receivedById        Int?
  createdBy           Int
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  details             ConsignmentReturnDetail[]
  branch              Branch                    @relation(fields: [branchId], references: [id])
  consignment         Consignment               @relation(fields: [consignmentId], references: [id])
  customer            Customer?                 @relation("ConsignmentReturnCustomer", fields: [customerId], references: [id])

  @@index([consignmentId])
  @@index([customerId])
  @@index([branchId])
  @@index([status])
  @@map("consignment_returns")
}

model ConsignmentReturnDetail {
