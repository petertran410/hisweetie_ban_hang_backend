/// Phiếu ghép xe (vehicle shipment) — tầng điều phối optional giữa PDN
/// (OrderSupplier) và PN (PurchaseOrder). Gom hàng từ nhiều PDN (có thể nhiều
/// NCC) lên 1 chuyến xe. KHÔNG tác động kho/tiền/công nợ — chỉ theo dõi SL ghép.
/// Tồn kho + thẻ kho vẫn chỉ phát sinh ở PN khi bấm "Tạo phiếu nhập".
model VehicleShipment {
  id                  Int       @id @default(autoincrement())
  code                String    @unique
