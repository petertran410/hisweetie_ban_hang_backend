  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_documents")
}

// ==================== STOCK AUDIT (Kiểm kho) ====================

model StockAudit {
  id              Int       @id @default(autoincrement())
  code            String    @unique
  branchId        Int
  branchName      String
  checkDate       DateTime  @default(now())
  note            String?
  status          Int       @default(1) // 1=DRAFT, 2=COMPLETED, 3=CANCELLED
  createdById     Int
  createdByName   String
  completedById   Int?
  completedByName String?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  branch      Branch             @relation(fields: [branchId], references: [id])
  creator     User               @relation("StockAuditCreator", fields: [createdById], references: [id])
  completedBy User?              @relation("StockAuditCompleter", fields: [completedById], references: [id])
  details     StockAuditDetail[]

  @@index([branchId])
  @@index([status])
  @@index([checkDate])
  @@map("stock_audits")
}

model StockAuditDetail {
  id              Int      @id @default(autoincrement())
  stockAuditId    Int
  productId       Int
  productCode     String
  productName     String
  unit            String?
  systemQuantity  Decimal  @default(0)
  actualQuantity  Decimal  @default(0)
  difference      Decimal  @default(0)
  costAtCheck     Decimal  @default(0)
  differenceValue Decimal  @default(0)
  note            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  stockAudit StockAudit @relation(fields: [stockAuditId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id])

  @@map("stock_audit_details")
}

model Production {
  id                    Int       @id @default(autoincrement())
  code                  String    @unique
  sourceBranchId        Int
  sourceBranchName      String
  destinationBranchId   Int
  destinationBranchName String
  productId             Int
  productCode           String
  productName           String
  quantity              Decimal   @default(0)
  totalCost             Decimal   @default(0)
  note                  String?
  status                Int       @default(1)
  createdById           Int
  createdByName         String
  autoDeductComponents  Boolean   @default(true)
  manufacturedDate      DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  sourceBranch      Branch                @relation("ProductionSource", fields: [sourceBranchId], references: [id])
  destinationBranch Branch                @relation("ProductionDestination", fields: [destinationBranchId], references: [id])
  product           Product               @relation(fields: [productId], references: [id])
  creator           User                  @relation("ProductionCreator", fields: [createdById], references: [id])
  components        ProductionComponent[]

  @@index([sourceBranchId])
  @@index([destinationBranchId])
  @@index([productId])
  @@index([status])
  @@index([manufacturedDate])
  @@map("productions")
}

model ProductionComponent {
  id                 Int     @id @default(autoincrement())
  productionId       Int
  componentProductId Int
  componentCode      String
  componentName      String
  formulaGrams       Decimal @db.Decimal(18, 4) // gram theo công thức
  actualGrams        Decimal @db.Decimal(18, 4) // gram thực tế nhân viên nhập
  unitsDeducted      Decimal @db.Decimal(18, 4) // số đơn vị thực tế trừ kho

  production       Production @relation(fields: [productionId], references: [id], onDelete: Cascade)
  componentProduct Product    @relation(fields: [componentProductId], references: [id])

  @@index([productionId])
  @@map("production_components")
}

model Inventory {
  id                 Int      @id @default(autoincrement())
  productId          Int
  productCode        String
  productName        String
  branchId           Int
  branchName         String
  cost               Decimal  @default(0)
  onHand             Decimal  @default(0)
  reserved           Decimal  @default(0)
  onOrder            Decimal  @default(0)
  minQuality         Decimal  @default(0)
  maxQuality         Decimal  @default(0)
  totalWeight        Decimal? @default(0)
  damagedQuantity    Decimal  @default(0)
  nearExpiryQuantity Decimal  @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  branch  Branch  @relation(fields: [branchId], references: [id])

  @@unique([productId, branchId])
  @@map("inventories")
}

model InventoryCheck {
  id            Int      @id @default(autoincrement())
  code          String   @unique
  branchId      Int
  branchName    String
  checkDate     DateTime @default(now())
  note          String?
  createdById   Int
  createdByName String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  status        Int      @default(1)

  branch  Branch                 @relation(fields: [branchId], references: [id])
  creator User                   @relation("InventoryCheckCreator", fields: [createdById], references: [id])
  details InventoryCheckDetail[]

  @@index([branchId])
  @@index([checkDate])
  @@map("inventory_checks")
}

model InventoryCheckDetail {
  id                 Int      @id @default(autoincrement())
  inventoryCheckId   Int
  productId          Int
  productCode        String
  productName        String
  currentOnHand      Decimal  @default(0)
  previousDamaged    Decimal  @default(0)
  previousNearExpiry Decimal  @default(0)
  damagedQuantity    Decimal  @default(0)
  nearExpiryQuantity Decimal  @default(0)
  note               String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  inventoryCheck InventoryCheck @relation(fields: [inventoryCheckId], references: [id], onDelete: Cascade)
  product        Product        @relation(fields: [productId], references: [id])

  @@map("inventory_check_details")
}

model InventoryLog {
  id               Int      @id @default(autoincrement())
  productId        Int
  productCode      String
  productName      String
  branchId         Int
  branchName       String
  transactionType  String
  refCode          String
  refType          String
  refId            Int
  quantity         Decimal
  costPrice        Decimal  @default(0)
  transactionPrice Decimal? @default(0)
  partnerId        Int?
  partnerName      String?
  note             String?
  manufactureDate  DateTime?
  // Thời điểm phát sinh giao dịch (cho phép lùi ngày — vd kiểm kho backdated).
  // Mặc định = createdAt khi không truyền. Thẻ kho sắp xếp theo field này.
  transactionDate  DateTime @default(now())
  createdAt        DateTime @default(now())
  createdByName    String?

  product Product @relation(fields: [productId], references: [id])
  branch  Branch  @relation(fields: [branchId], references: [id])

  @@index([productId])
  @@index([branchId])
  @@index([productId, branchId])
  @@index([createdAt])
  @@index([transactionDate])
  @@index([productId, branchId, transactionDate])
  @@map("inventory_logs")
}

model PriceBook {
  id                     Int       @id @default(autoincrement())
  name                   String
  kiotVietId             Int?      @unique @map("kiot_viet_id")
  lastSyncedAt           DateTime? @map("last_synced_at")
  isActive               Boolean   @default(true)
  isGlobal               Boolean   @default(false)
  startDate              DateTime?
  endDate                DateTime?
  allowNonListedProducts Boolean   @default(true)
  warnNonListedProducts  Boolean   @default(false)
  priority               Int       @default(0)
  forAllCusGroup         Boolean   @default(false)
  forAllCustomer         Boolean   @default(true)
  forAllUser             Boolean   @default(false)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  priceBookDetails        PriceBookDetail[]
  priceBookBranches       PriceBookBranch[]
  priceBookCustomerGroups PriceBookCustomerGroup[]
  priceBookCustomers      PriceBookCustomer[]
  priceBookUsers          PriceBookUser[]
  Product                 Product[]
  orders                  Order[]                  @relation("OrderPriceBook")
  invoices                Invoice[]                @relation("InvoicePriceBook")
  consignments            Consignment[]            @relation("ConsignmentPriceBook")

