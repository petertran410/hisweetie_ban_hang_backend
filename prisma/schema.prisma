  creator              User                         @relation("OrderSupplierCreator", fields: [createdBy], references: [id])
  supplier             Supplier                     @relation(fields: [supplierId], references: [id])
  user                 User?                        @relation("OrderSupplierUser", fields: [userId], references: [id])
