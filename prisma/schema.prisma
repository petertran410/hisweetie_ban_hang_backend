model Promotion {
  id                Int       @id @default(autoincrement())
  code              String    @unique
  name              String
  type              String // INVOICE_DISCOUNT | PRODUCT_DISCOUNT | BUY_X_GET_Y | BUY_N_GET_M_SAME | BUY_X_BUY_Y_PRICE | GIFT_BY_INVOICE | CATEGORY_DISCOUNT
  description       String?
  isActive          Boolean   @default(false)
  status            String    @default("draft") // draft | running | paused | stopped | expired
  priority          Int       @default(0)
  stackable         Boolean   @default(false)
  startDate         DateTime?
  endDate           DateTime?
  applyTimeFrom     String? // "08:00"
  applyTimeTo       String? // "22:00"
  applyWeekdays     Int[]     @default([]) // [1..7], rỗng = mọi ngày
  forAllBranch      Boolean   @default(true)
  forAllCustomer    Boolean   @default(true)
  forAllUser        Boolean   @default(true)
  minOrderValue     Decimal   @default(0)
  minQuantity       Decimal   @default(0)
  maxDiscountAmount Decimal?
  maxRewardQuantity Decimal?
  usageLimit        Int?
  usageCount        Int       @default(0)
  autoApply         Boolean   @default(true)
  createdBy         Int
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  rewards        PromotionReward[]
  branches       PromotionBranch[]
  customers      PromotionCustomer[]
  customerGroups PromotionCustomerGroup[]
  users          PromotionUser[]
  products       PromotionProduct[]
  logs           InvoicePromotionLog[]
  invoiceDetails InvoiceDetail[]
  orderItems     OrderItem[]

  @@index([isActive, status])
  @@index([type])
  @@map("promotions")
}

model PromotionReward {
  id              Int      @id @default(autoincrement())
  promotionId     Int
  buyProductId    Int?
  buyCategoryName String?
  buyQuantity     Decimal  @default(0)
  rewardType      String // discount_percent | discount_amount | gift | discounted_buy
  rewardProductId Int?
  rewardQuantity  Decimal  @default(0)
  rewardValue     Decimal  @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  promotion     Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  buyProduct    Product?  @relation("PromotionBuyProduct", fields: [buyProductId], references: [id])
  rewardProduct Product?  @relation("PromotionRewardProduct", fields: [rewardProductId], references: [id])

  @@index([promotionId])
  @@map("promotion_rewards")
}

model PromotionProduct {
  id           Int      @id @default(autoincrement())
  promotionId  Int
  role         String // 'buy' (X) | 'reward' (Y)
  productId    Int?
  categoryName String?
  createdAt    DateTime @default(now())

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product   Product?  @relation("PromotionProductRef", fields: [productId], references: [id])

  @@index([promotionId])
  @@map("promotion_products")
}

model PromotionBranch {
  id          Int      @id @default(autoincrement())
  promotionId Int
  branchId    Int
  createdAt   DateTime @default(now())

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  branch    Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([promotionId, branchId])
  @@map("promotion_branches")
}

model PromotionCustomer {
  id          Int      @id @default(autoincrement())
  promotionId Int
  customerId  Int
  createdAt   DateTime @default(now())

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  customer  Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([promotionId, customerId])
  @@map("promotion_customers")
}

model PromotionCustomerGroup {
  id              Int      @id @default(autoincrement())
  promotionId     Int
  customerGroupId Int
  createdAt       DateTime @default(now())

  promotion     Promotion     @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  customerGroup CustomerGroup @relation(fields: [customerGroupId], references: [id], onDelete: Cascade)

  @@unique([promotionId, customerGroupId])
  @@map("promotion_customer_groups")
}

model PromotionUser {
  id          Int      @id @default(autoincrement())
  promotionId Int
  userId      Int
  createdAt   DateTime @default(now())

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  user      User      @relation("PromotionUserRef", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([promotionId, userId])
  @@map("promotion_users")
}

model InvoicePromotionLog {
  id             Int      @id @default(autoincrement())
  invoiceId      Int?
  orderId        Int?
  promotionId    Int
  promotionCode  String
  promotionName  String
  type           String
  discountAmount Decimal  @default(0)
  giftValue      Decimal  @default(0)
  rewardSnapshot Json
  status         String   @default("applied") // applied | reverted
  createdAt      DateTime @default(now())

  invoice   Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  order     Order?    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  promotion Promotion @relation(fields: [promotionId], references: [id])

  @@index([invoiceId])
  @@index([orderId])
  @@index([promotionId])
  @@map("invoice_promotion_logs")
}

/// Thông báo cho người dùng (in-app). Thiết kế tổng quát theo `type`,
/// trước mắt dùng cho giao dịch Sepay ("sepay_transaction").
model Notification {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  type      String // vd: "sepay_transaction"
  title     String
  body      String?
  /// Dữ liệu kèm theo (txId, referenceNumber, amountIn, ...). Dùng để render.
  data      Json?
  /// Deep-link dựng sẵn để điều hướng khi click.
  link      String?
  /// Khóa chống trùng trong cùng (userId, type) — vd sepayId. Sepay retry
  /// webhook nhiều lần cũng không tạo thông báo lặp.
  dedupeKey String?   @map("dedupe_key")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, dedupeKey])
  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@map("notifications")
}
