  code         String    @unique
  kiotVietId   Int?      @unique @map("kiot_viet_id")
  lastSyncedAt DateTime? @map("last_synced_at")
  name         String
  valueRatio   Decimal?
  value        Decimal?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  orderSurcharges             OrderSurcharge[]
  invoiceSurcharges           InvoiceSurcharge[]
  purchaseOrderSurcharges     PurchaseOrderSurcharge[]
  orderSupplierExpensesOthers OrderSupplierExpensesOther[]

  @@map("surcharges")
}

model BankAccount {
  id            Int       @id @default(autoincrement())
  accountNumber String
  kiotVietId    Int?      @unique @map("kiot_viet_id")
  lastSyncedAt  DateTime? @map("last_synced_at")
  bankCode      String
  bankName      String
  accountHolder String
  note          String?
  scope         String
  branchIds     Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  orderPayments         OrderPayment[]
  invoicePayments       InvoicePayment[]
  purchaseOrderPayments PurchaseOrderPayment[]
  cashFlows             CashFlow[]
  orderSupplierPayments OrderSupplierPayment[]
  userMappings          UserBankAccount[]

  @@map("bank_accounts")
}

model UserBankAccount {
  id            Int      @id @default(autoincrement())
  userId        Int      @unique
  bankAccountId Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)

  @@index([bankAccountId])
  @@map("user_bank_accounts")
}

model PartnerDelivery {
  id            Int      @id @default(autoincrement())
  code          String   @unique
  name          String
  address       String?
  contactNumber String?
  email         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orderDeliveries   OrderDelivery[]
  invoiceDeliveries InvoiceDelivery[]

  @@map("partner_deliveries")
}

model Order {
  id            Int       @id @default(autoincrement())
  code          String    @unique
  kiotVietId    BigInt?   @unique @map("kiot_viet_id")
  lastSyncedAt  DateTime? @map("last_synced_at")
  customerId    Int?
  branchId      Int?
  soldById      Int?
  saleChannelId Int?
  priceBookId   Int?
  priceBookName String?
  orderDate     DateTime  @default(now())
  totalAmount   Decimal   @default(0)
  discount      Decimal   @default(0)
  discountRatio Decimal   @default(0)
  grandTotal    Decimal   @default(0)
  paidAmount    Decimal   @default(0)
  debtAmount    Decimal   @default(0)
  depositAmount Decimal   @default(0)
  paymentStatus String    @default("Draft")
  orderStatus   String    @default("Draft")
  status        Int       @default(1)
  statusValue   String?
  usingCod      Boolean   @default(false)
  description   String?
  createdBy     Int
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  larkRecordId    String?
  larkSyncStatus  String    @default("PENDING")
  larkSyncRetries Int       @default(0)
  larkSyncedAt    DateTime?

  customer      Customer?             @relation(fields: [customerId], references: [id])
  branch        Branch?               @relation(fields: [branchId], references: [id])
  soldBy        User?                 @relation("OrderSeller", fields: [soldById], references: [id])
  saleChannel   SaleChannel?          @relation(fields: [saleChannelId], references: [id])
  creator       User                  @relation("OrderCreator", fields: [createdBy], references: [id])
  priceBook     PriceBook?            @relation("OrderPriceBook", fields: [priceBookId], references: [id])
  invoices      Invoice[]
  items         OrderItem[]
  payments      OrderPayment[]
  surcharges    OrderSurcharge[]
  delivery      OrderDelivery?
  promotionLogs InvoicePromotionLog[]

  @@index([larkSyncStatus])
  @@map("orders")
}

model OrderItem {
  id            Int      @id @default(autoincrement())
  orderId       Int
  productId     Int
  productCode   String
  productName   String
  quantity      Decimal  @default(0) @db.Decimal(18, 4)
  price         Decimal  @default(0) @db.Decimal(18, 2)
  appliedPrice  Decimal  @default(0) @db.Decimal(18, 2)
  discount      Decimal  @default(0) @db.Decimal(18, 2)
  discountRatio Decimal  @default(0) @db.Decimal(18, 4)
  totalPrice    Decimal  @default(0) @db.Decimal(18, 2)
  note          String?
  conditionType String   @default("normal")
  serialNumbers String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lineNumber    Int?
  // Promotion / khuyến mãi
  lineType      String   @default("normal") // normal | gift | discounted_buy
  isGift        Boolean  @default(false)
  promotionId   Int?

  order     Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product    @relation(fields: [productId], references: [id])
  promotion Promotion? @relation(fields: [promotionId], references: [id], onDelete: SetNull)

  @@unique([orderId, lineNumber])
  @@index([promotionId])
  @@map("order_items")
}

model OrderPayment {
  id                 Int      @id @default(autoincrement())
  code               String
  kiotVietId         BigInt?  @unique @map("kiot_viet_id")
  orderId            Int
  amount             Decimal
  paymentDate        DateTime @default(now())
  paymentMethod      String   @default("cash")
  accountId          Int?
  bankAccount        String?
  description        String?
  sepayTransactionId String?  @unique @map("sepay_transaction_id")
  sepayReferenceCode String?  @map("sepay_reference_code")
  status             Int      @default(1)
  statusValue        String?
  createdBy          Int
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  order   Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  account BankAccount? @relation(fields: [accountId], references: [id])
  creator User         @relation("PaymentCreator", fields: [createdBy], references: [id])

  @@unique([code, orderId])
  @@index([code])
  @@map("order_payments")
}

model OrderSurcharge {
  id            Int      @id @default(autoincrement())
  orderId       Int
  surchargeId   Int?
  surchargeName String
  surValue      Decimal?
  price         Decimal?
  createdAt     DateTime @default(now())

  order     Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  surcharge Surcharge? @relation(fields: [surchargeId], references: [id])

  @@map("order_surcharges")
}

model OrderDelivery {
  id                Int       @id @default(autoincrement())
  orderId           Int       @unique
  deliveryCode      String?
  type              Int?
  status            Int       @default(1)
  statusValue       String?
  price             Decimal?
  receiver          String
  contactNumber     String
  address           String
  locationId        Int?
  locationName      String?
  wardName          String?
  weight            Decimal?
  length            Decimal?
  width             Decimal?
  weightUnit        String?   @default("g")
  height            Decimal?
  noteForDriver     String?
  partnerDeliveryId Int?
  expectedDelivery  DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  order           Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  location        Location?        @relation(fields: [locationId], references: [id])
  partnerDelivery PartnerDelivery? @relation(fields: [partnerDeliveryId], references: [id])

  @@map("order_deliveries")
}

model Invoice {
  id                     Int            @id @default(autoincrement())
  code                   String         @unique
  kiotVietId             BigInt?        @unique @map("kiot_viet_id")
  lastSyncedAt           DateTime?      @map("last_synced_at")
  orderId                Int?
  consignmentId          Int?
  customerId             Int?
  parentCustomerId       Int?
  branchId               Int?
  soldById               Int?
  saleChannelId          Int?
  priceBookId            Int?
  priceBookName          String?
  purchaseDate           DateTime       @default(now())
  totalAmount            Decimal        @default(0)
  discount               Decimal        @default(0)
  discountRatio          Decimal        @default(0)
  grandTotal             Decimal        @default(0)
  paidAmount             Decimal        @default(0)
  debtAmount             Decimal        @default(0)
  customerDebtSnapshot   Decimal?       @db.Decimal(15, 2)
  status                 Int            @default(3)
  statusValue            String?
  usingCod               Boolean        @default(false)
  description            String?
  createdBy              Int
  // Snapshot khách hàng cho Misa (đề phòng đổi tên Customer sau này)
  customerName           String?
  // Misa sync tracking
  misaSyncStatus         MisaSyncStatus @default(SKIP)
  misaSyncRetries        Int            @default(0)
  misaSyncedAt           DateTime?
  misaOrgRefId           String?        @unique
  misaCallbackReceivedAt DateTime?
  misaConfirmed          Boolean        @default(false)
  misaErrorMessage       String?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  order              Order?                  @relation(fields: [orderId], references: [id])
  consignment        Consignment?            @relation(fields: [consignmentId], references: [id])
  customer           Customer?               @relation("InvoiceCustomer", fields: [customerId], references: [id])
  parentCustomer     Customer?               @relation("InvoiceParentCustomer", fields: [parentCustomerId], references: [id])
  branch             Branch?                 @relation(fields: [branchId], references: [id])
  soldBy             User?                   @relation("InvoiceSeller", fields: [soldById], references: [id])
  saleChannel        SaleChannel?            @relation(fields: [saleChannelId], references: [id])
  creator            User                    @relation("InvoiceCreator", fields: [createdBy], references: [id])
  priceBook          PriceBook?              @relation("InvoicePriceBook", fields: [priceBookId], references: [id])
  details            InvoiceDetail[]
  payments           InvoicePayment[]
  surcharges         InvoiceSurcharge[]
  delivery           InvoiceDelivery?
  packingSlips       PackingSlipInvoice[]
  packingHangs       PackingHangInvoice[]
  packingLoadings    PackingLoadingInvoice[]
  returnOrders       ReturnOrder[]
  returnOrderDetails ReturnOrderDetail[]
  promotionLogs      InvoicePromotionLog[]

  @@index([purchaseDate])
  @@index([customerId, purchaseDate])
  @@index([branchId, purchaseDate])
  @@index([misaSyncStatus])
  @@map("invoices")
}

model InvoiceDetail {
  id            Int      @id @default(autoincrement())
  invoiceId     Int
  productId     Int?
  productCode   String
  productName   String
  quantity      Decimal
  price         Decimal
  discount      Decimal  @default(0)
  discountRatio Decimal  @default(0)
  totalPrice    Decimal
  note          String?
  conditionType String   @default("normal")
  manufactureDate DateTime?
  serialNumbers String?
  // Promotion / khuyến mãi
  lineType      String   @default("normal") // normal | gift | promo_discount | discounted_buy
  isGift        Boolean  @default(false)
  promotionId   Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  invoice   Invoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product   Product?   @relation(fields: [productId], references: [id])
  promotion Promotion? @relation(fields: [promotionId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([promotionId])
  @@map("invoice_details")
}

model InvoicePayment {
  id                 Int      @id @default(autoincrement())
  code               String
  kiotVietId         BigInt?  @unique @map("kiot_viet_id")
  invoiceId          Int
  paymentDate        DateTime @default(now())
  amount             Decimal
  status             Int
  statusValue        String?
  paymentMethod      String?
  accountId          Int?
  description        String?
  cashFlowId         Int?
  sepayTransactionId String?  @unique @map("sepay_transaction_id")
  sepayReferenceCode String?  @map("sepay_reference_code")
