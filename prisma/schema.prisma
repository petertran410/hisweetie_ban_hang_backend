generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                                                        Int                               @id @default(autoincrement())
  name                                                      String
  email                                                     String                            @unique
  password                                                  String?
  phone                                                     String?
  avatar                                                    String?
  googleId                                                  String?                           @unique
  branchId                                                  Int?
  isActive                                                  Boolean                           @default(true)
  createdAt                                                 DateTime                          @default(now())
  updatedAt                                                 DateTime                          @updatedAt
  canViewOtherStaffData                                     Boolean                           @default(false) @map("can_view_other_staff_data")
  permissionVersion                                         Int                               @default(1) @map("permission_version")
  kiotVietId                                                BigInt?                           @unique @map("kiot_viet_id")
  lastSyncedAt                                              DateTime?                         @map("last_synced_at")
  canViewOnlyOwnPackings                                    Boolean                           @default(false) @map("can_view_only_own_packings")
  larkUserId                                                String?                           @unique @map("lark_user_id")
  canViewOnlyOwnLoadingInvoices                             Boolean                           @default(false) @map("can_view_only_own_loading_invoices")
  supplierId                                                Int?                              @map("supplier_id")
  auditLogs                                                 AuditLog[]                        @relation("AuditLogUser")
  cashFlowsCollected                                        CashFlow[]                        @relation("CashFlowCollector")
  cashFlowsCreated                                          CashFlow[]                        @relation("CashFlowCreator")
  createdConsignments                                       Consignment[]                     @relation("ConsignmentCreator")
  soldConsignments                                          Consignment[]                     @relation("ConsignmentSeller")
  createdContracts                                          Contract[]                        @relation("ContractCreator")
  createdCustomerGroups                                     CustomerGroup[]                   @relation("CustomerGroupCreator")
  createdCustomers                                          Customer[]                        @relation("CustomerCreator")
  updatedCustomers                                          Customer[]                        @relation("CustomerUpdater")
  createdDestructions                                       Destruction[]                     @relation("DestructionCreator")
  createdFactories                                          Factory[]                         @relation("FactoryCreator")
  factoryChangeLogs                                         FactoryChangeLog[]                @relation("FactoryChangeLogChanger")
  factory_product_price_histories                           factory_product_price_histories[]
  factory_products_factory_products_createdByTousers        factory_products[]                @relation("factory_products_createdByTousers")
  factory_products_factory_products_priceUpdatedByIdTousers factory_products[]                @relation("factory_products_priceUpdatedByIdTousers")
  createdInternalUses                                       InternalUse[]                     @relation("InternalUseCreator")
  usedInternalUses                                          InternalUse[]                     @relation("InternalUseUser")
  createdInventoryChecks                                    InventoryCheck[]                  @relation("InventoryCheckCreator")
  inventoryLogs                                             InventoryLog[]                    @relation("InventoryLogUser")
  createdInventoryPromoChecks                               InventoryPromoCheck[]             @relation("InventoryPromoCheckCreator")
  createdInvoicePaymentNotes                                InvoicePaymentNote[]              @relation("InvoicePaymentNoteCreator")
  createdInvoices                                           Invoice[]                         @relation("InvoiceCreator")
  soldInvoices                                              Invoice[]                         @relation("InvoiceSeller")
  notifications                                             Notification[]
  createdOrderPaymentNotes                                  OrderPaymentNote[]                @relation("OrderPaymentNoteCreator")
  createdPayments                                           OrderPayment[]                    @relation("PaymentCreator")
  createdOrderSuppliers                                     OrderSupplier[]                   @relation("OrderSupplierCreator")
  orderSuppliers                                            OrderSupplier[]                   @relation("OrderSupplierUser")
  createdOrders                                             Order[]                           @relation("OrderCreator")
  soldOrders                                                Order[]                           @relation("OrderSeller")
  cancelledPackingHangs                                     PackingHang[]                     @relation("PackingHangCancelledBy")
  createdPackingHangs                                       PackingHang[]                     @relation("PackingHangCreator")
  cancelledPackingLoadings                                  PackingLoading[]                  @relation("PackingLoadingCancelledBy")
  createdPackingLoadings                                    PackingLoading[]                  @relation("PackingLoadingCreator")
  loadedPackingLoadings                                     PackingLoading[]                  @relation("PackingLoadingUser")
  cancelledPackingSlips                                     PackingSlip[]                     @relation("PackingSlipCancelledBy")
  createdPackingSlips                                       PackingSlip[]                     @relation("PackingSlipCreator")
  paidPackingSlips                                          PackingSlip[]                     @relation("PackingSlipExpensePayer")
  posts                                                     Post[]                            @relation("PostAuthor")
  priceBookUsers                                            PriceBookUser[]
  createdPrintTemplates                                     PrintTemplate[]                   @relation("PrintTemplateCreator")
  updatedPrintTemplates                                     PrintTemplate[]                   @relation("PrintTemplateUpdater")
  createdProductions                                        Production[]                      @relation("ProductionCreator")
  promotionUsers                                            PromotionUser[]                   @relation("PromotionUserRef")
  createdPurchaseOrders                                     PurchaseOrder[]                   @relation("PurchaseOrderCreator")
  purchaseOrders                                            PurchaseOrder[]                   @relation("PurchaseOrderBuyer")
  confirmedReturnOrders                                     ReturnOrder[]                     @relation("ReturnOrderConfirmer")
  createdReturnOrders                                       ReturnOrder[]                     @relation("ReturnOrderCreator")
  receivedReturnOrders                                      ReturnOrder[]                     @relation("ReturnOrderReceiver")
  refundConfirmedReturnOrders                               ReturnOrder[]                     @relation("ReturnOrderRefundConfirmer")
  stockAuditsCompleted                                      StockAudit[]                      @relation("StockAuditCompleter")
  stockAuditsCreated                                        StockAudit[]                      @relation("StockAuditCreator")
  approvedStockConditionTransfers                           StockConditionTransfer[]          @relation("StockConditionTransferApprover")
  createdStockConditionTransfers                            StockConditionTransfer[]          @relation("StockConditionTransferCreator")
  createdSupplierGroups                                     SupplierGroup[]                   @relation("SupplierGroupCreator")
  createdSupplierReturns                                    SupplierReturn[]                  @relation("SupplierReturnCreator")
  exportedSupplierReturns                                   SupplierReturn[]                  @relation("SupplierReturnExporter")
  refundConfirmedSupplierReturns                            SupplierReturn[]                  @relation("SupplierReturnRefundConfirmer")
  createdSuppliers                                          Supplier[]                        @relation("SupplierCreator")
  createdTransfers                                          Transfer[]                        @relation("TransferCreator")
  bankAccountMapping                                        UserBankAccount?
  branchPermissions                                         UserBranchPermission[]
  userBranchRoles                                           UserBranchRole[]
  userBranches                                              UserBranch[]
  userPermissions                                           UserPermission[]
  userRoles                                                 UserRole[]
  branch                                                    Branch?                           @relation(fields: [branchId], references: [id])
  supplier                                                  Supplier?                         @relation("SupplierStaff", fields: [supplierId], references: [id])
  createdVehicleShipments                                   VehicleShipment[]                 @relation("VehicleShipmentCreator")
  createdRecipes                                            Recipe[]                          @relation("RecipeCreator")
  updatedRecipes                                            Recipe[]                          @relation("RecipeUpdater")
  publishedRecipes                                          Recipe[]                          @relation("RecipePublisher")
  recipeComments                                            RecipeComment[]                   @relation("RecipeCommentAuthor")
  createdIngredients                                        Ingredient[]                      @relation("IngredientCreator")
  updatedIngredients                                        Ingredient[]                      @relation("IngredientUpdater")

  @@map("users")
}

model UserBranch {
  userId    Int
  branchId  Int
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, branchId])
  @@map("user_branches")
}

model UserBranchRole {
  userId    Int
  branchId  Int
  roleId    Int
  createdAt DateTime @default(now())
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, branchId])
  @@map("user_branch_roles")
}

model Role {
  id                    Int                    @id @default(autoincrement())
  name                  String                 @unique
  description           String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  roleBranchPermissions RoleBranchPermission[]
  rolePermissions       RolePermission[]
  userBranchRoles       UserBranchRole[]
  userRoles             UserRole[]

  @@map("roles")
}

model Permission {
  id                    Int                    @id @default(autoincrement())
  name                  String                 @unique
  resource              String
  action                String
  description           String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  category              String?
  field                 String?
  scope                 String                 @default("all")
  roleBranchPermissions RoleBranchPermission[]
  rolePermissions       RolePermission[]
  userBranchPermissions UserBranchPermission[]
  userPermissions       UserPermission[]

  @@unique([resource, action, scope, field])
  @@index([resource])
  @@index([category])
  @@map("permissions")
}

model PermissionGroup {
  id          Int               @id @default(autoincrement())
  name        String            @unique
  code        String            @unique
  description String?
  parentId    Int?
  order       Int               @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  parent      PermissionGroup?  @relation("PermissionGroupHierarchy", fields: [parentId], references: [id])
  children    PermissionGroup[] @relation("PermissionGroupHierarchy")

  @@map("permission_groups")
}

model FieldPermission {
  id           Int      @id @default(autoincrement())
  resource     String
  fieldName    String
  fieldLabel   String
  canView      Boolean  @default(true)
  canEdit      Boolean  @default(true)
  isRequired   Boolean  @default(false)
  defaultValue String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([resource, fieldName])
  @@map("field_permissions")
}

model ColumnPermission {
  id          Int      @id @default(autoincrement())
  resource    String
  columnName  String
  columnLabel String
  canView     Boolean  @default(true)
  canExport   Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([resource, columnName])
  @@map("column_permissions")
}

model UserRole {
  userId    Int
  roleId    Int
  createdAt DateTime @default(now())
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       Int
  permissionId Int
  createdAt    DateTime   @default(now())
  conditions   Json?
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model RoleBranchPermission {
  id           Int        @id @default(autoincrement())
  roleId       Int
  branchId     Int
  permissionId Int
  createdAt    DateTime   @default(now())
  branch       Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, branchId, permissionId])
  @@map("role_branch_permissions")
}

model UserPermission {
  userId       Int
  permissionId Int
  conditions   Json?
  createdAt    DateTime   @default(now())
  type         String     @default("grant")
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
  @@map("user_permissions")
}

model Branch {
  id                      Int                      @id @default(autoincrement())
  name                    String
  code                    String?                  @unique
  contactNumber           String?
  subContactNumber        String?
  email                   String?
  address                 String?
  locationId              Int?
  wardName                String?
  isActive                Boolean                  @default(true)
  isLock                  Boolean                  @default(false)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  kiotVietId              Int?                     @unique @map("kiot_viet_id")
  lastSyncedAt            DateTime?                @map("last_synced_at")
  auditLogs               AuditLog[]               @relation("AuditLogBranch")
  location                Location?                @relation(fields: [locationId], references: [id])
  cashFlows               CashFlow[]
  consignmentReturns      ConsignmentReturn[]
  consignments            Consignment[]
  customers               Customer[]
  destructions            Destruction[]
  internalUses            InternalUse[]
  inventories             Inventory[]
  inventoryChecks         InventoryCheck[]
  inventoryLogs           InventoryLog[]
  inventoryPromoChecks    InventoryPromoCheck[]
  invoices                Invoice[]
  orderSuppliers          OrderSupplier[]
  orders                  Order[]
  packingHangs            PackingHang[]
  packingLoadings         PackingLoading[]
  packingSlips            PackingSlip[]
  priceBookBranches       PriceBookBranch[]
  productionsDestination  Production[]             @relation("ProductionDestination")
  productionsSource       Production[]             @relation("ProductionSource")
  promotionBranches       PromotionBranch[]
  purchaseOrders          PurchaseOrder[]
  returnOrders            ReturnOrder[]
  roleBranchPermissions   RoleBranchPermission[]
  stockAudits             StockAudit[]
  stockConditionLogs      StockConditionLog[]
  stockConditionTransfers StockConditionTransfer[]
  supplierReturns         SupplierReturn[]
  suppliers               Supplier[]
  transfersFrom           Transfer[]               @relation("TransferFrom")
  transfersTo             Transfer[]               @relation("TransferTo")
  userBranchPermissions   UserBranchPermission[]
  userBranchRoles         UserBranchRole[]
  userBranches            UserBranch[]
  users                   User[]
  vehicleShipments        VehicleShipment[]

  @@map("branches")
}

model UserBranchPermission {
  id           Int        @id @default(autoincrement())
  userId       Int
  branchId     Int
  permissionId Int
  granted      Boolean    @default(true)
  createdAt    DateTime   @default(now())
  branch       Branch     @relation(fields: [branchId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])
  user         User       @relation(fields: [userId], references: [id])

  @@unique([userId, branchId, permissionId])
  @@map("user_branch_permissions")
}

model Location {
  id                Int               @id @default(autoincrement())
  name              String
  normalName        String
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  branches          Branch[]
  invoiceDeliveries InvoiceDelivery[]
  orderDeliveries   OrderDelivery[]

  @@map("locations")
}

model CustomerType {
  id          Int        @id @default(autoincrement())
  name        String
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  customers   Customer[]

  @@map("customer_types")
}

model CustomerGroup {
  id                      Int                      @id @default(autoincrement())
  name                    String
  description             String?
  createdBy               Int?
  createdAt               DateTime                 @default(now())
  allowedUserIds          Int[]                    @default([])
  autoAddConditions       Json?
  autoExecute             Boolean                  @default(false)
  autoUpdateMode          String?
  discount                Decimal?
  kiotVietId              Int?                     @unique @map("kiot_viet_id")
  lastSyncedAt            DateTime?                @map("last_synced_at")
  customerGroupDetails    CustomerGroupDetail[]
  creator                 User?                    @relation("CustomerGroupCreator", fields: [createdBy], references: [id])
  priceBookCustomerGroups PriceBookCustomerGroup[]
  promotionCustomerGroups PromotionCustomerGroup[]

  @@map("customer_groups")
}

model Customer {
  id                   Int                   @id @default(autoincrement())
  code                 String?               @unique
  name                 String
  gender               Boolean?
  birthDate            DateTime?
  contactNumber        String?
  phone                String?
  email                String?
  type                 Int                   @default(0)
  organization         String?
  taxCode              String?
  groups               String?
  comments             String?
  customerTypeId       Int?
  branchId             Int?
  totalPurchased       Decimal               @default(0)
  totalDebt            Decimal               @default(0)
  totalInvoiced        Decimal               @default(0)
  totalPoint           Decimal               @default(0)
  totalRevenue         Decimal               @default(0)
  rewardPoint          Int                   @default(0)
  isActive             Boolean               @default(true)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  invoiceAddress       String?
  invoiceBankAccount   String?
  invoiceBuyerName     String?
  invoiceCccdCmnd      String?
  invoiceCityCode      String?
  invoiceCityName      String?
  invoiceDvqhnsCode    String?
  invoiceEmail         String?
  invoicePhone         String?
  invoiceWardCode      String?
  invoiceWardName      String?
  parentId             Int?
  kiotVietId           BigInt?               @unique @map("kiot_viet_id")
  lastSyncedAt         DateTime?             @map("last_synced_at")
  createdBy            Int?
  updatedBy            Int?
  identificationNumber String?
  misaEmployeeCode     String?               @db.VarChar(50)
  misaEmployeeId       String?               @db.VarChar(36)
  misaEmployeeName     String?               @db.VarChar(255)
  larkRecordId         String?
  larkSyncRetries      Int                   @default(0)
  larkSyncStatus       String                @default("PENDING")
  larkSyncedAt         DateTime?
  consignmentReturns   ConsignmentReturn[]   @relation("ConsignmentReturnCustomer")
  consignments         Consignment[]
  contracts            Contract[]
  addresses            CustomerAddress[]
  customerGroupDetails CustomerGroupDetail[]
  branch               Branch?               @relation(fields: [branchId], references: [id])
  creator              User?                 @relation("CustomerCreator", fields: [createdBy], references: [id])
  customerType         CustomerType?         @relation(fields: [customerTypeId], references: [id])
  parent               Customer?             @relation("CustomerHierarchy", fields: [parentId], references: [id])
  children             Customer[]            @relation("CustomerHierarchy")
  updater              User?                 @relation("CustomerUpdater", fields: [updatedBy], references: [id])
  invoices             Invoice[]             @relation("InvoiceCustomer")
  parentInvoices       Invoice[]             @relation("InvoiceParentCustomer")
  orders               Order[]
  priceBookCustomers   PriceBookCustomer[]
  promotionCustomers   PromotionCustomer[]
  returnOrders         ReturnOrder[]         @relation("ReturnOrderCustomer")
  parentReturnOrders   ReturnOrder[]         @relation("ReturnOrderParentCustomer")

  @@index([larkSyncStatus])
  @@map("customers")
}

model CustomerAddress {
  id               Int       @id @default(autoincrement())
  customerId       Int
  label            String?
  receiver         String?
  contactNumber    String?
  address          String?
  cityCode         String?
  cityName         String?
  districtCode     String?
  districtName     String?
  wardCode         String?
  wardName         String?
  newCityCode      String?
  newCityName      String?
  newWardCode      String?
  newWardName      String?
  locationName     String?
  isDefault        Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  formattedAddress String?   @map("formatted_address")
  geocodePrecision String?   @map("geocode_precision")
  geocodeProvider  String?   @map("geocode_provider")
  geocodedAt       DateTime? @map("geocoded_at")
  latitude         Float?
  longitude        Float?
  customer         Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("customer_addresses")
}

model CustomerGroupDetail {
  id              Int           @id @default(autoincrement())
  customerId      Int
  customerGroupId Int
  customerGroup   CustomerGroup @relation(fields: [customerGroupId], references: [id], onDelete: Cascade)
  customer        Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, customerGroupId])
  @@map("customer_group_details")
}

model Supplier {
  id                         Int                   @id @default(autoincrement())
  code                       String?               @unique
  name                       String
  contactNumber              String?
  email                      String?
  address                    String?
  location                   String?
  wardName                   String?
  organization               String?
  taxCode                    String?
  comments                   String?
  groups                     String?
  isActive                   Boolean               @default(true)
  createdBy                  Int?
  createdName                String?
  branchId                   Int?
  debt                       Decimal               @default(0)
  totalInvoiced              Decimal               @default(0)
  totalInvoicedWithoutReturn Decimal               @default(0)
  createdAt                  DateTime              @default(now())
  updatedAt                  DateTime              @updatedAt
  kiotVietId                 BigInt?               @unique @map("kiot_viet_id")
  lastSyncedAt               DateTime?             @map("last_synced_at")
  factories                  Factory[]
  orderSuppliers             OrderSupplier[]
  purchaseOrders             PurchaseOrder[]
  supplierGroupDetails       SupplierGroupDetail[]
  supplierReturns            SupplierReturn[]
  branch                     Branch?               @relation(fields: [branchId], references: [id])
  creator                    User?                 @relation("SupplierCreator", fields: [createdBy], references: [id])
  staffUsers                 User[]                @relation("SupplierStaff")

  @@map("suppliers")
}

model SupplierGroup {
  id                   Int                   @id @default(autoincrement())
  name                 String
  description          String?
  createdBy            Int?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  supplierGroupDetails SupplierGroupDetail[]
  creator              User?                 @relation("SupplierGroupCreator", fields: [createdBy], references: [id])

  @@map("supplier_groups")
}

model SupplierGroupDetail {
  id              Int           @id @default(autoincrement())
  supplierId      Int
  supplierGroupId Int
  supplierGroup   SupplierGroup @relation(fields: [supplierGroupId], references: [id], onDelete: Cascade)
  supplier        Supplier      @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([supplierId, supplierGroupId])
  @@map("supplier_group_details")
}

model SupplierReturn {
  id                       Int                    @id @default(autoincrement())
  code                     String                 @unique
  mode                     String                 @default("by_purchase_order")
  purchaseOrderId          Int?
  supplierId               Int
  branchId                 Int
  status                   Int                    @default(1)
  statusValue              String?
  totalReturnAmount        Decimal                @default(0)
  refundAmount             Decimal                @default(0)
  refundType               String?
  refundedAmount           Decimal                @default(0)
  note                     String?
  exportedById             Int?
  exportedByName           String?
  exportedAt               DateTime?
  refundConfirmedBy        Int?
  refundConfirmedByName    String?
  refundConfirmedAt        DateTime?
  cashFlowId               Int?
  createdBy                Int
  createdByName            String?
  images                   String?
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  currency                 String                 @default("VND")
  exchangeRate             Decimal                @default(1)
  refundForeignAmount      Decimal?
  refundedForeignAmount    Decimal?
  totalForeignReturnAmount Decimal?
  details                  SupplierReturnDetail[]
  branch                   Branch                 @relation(fields: [branchId], references: [id])
  cashFlow                 CashFlow?              @relation(fields: [cashFlowId], references: [id])
  creator                  User                   @relation("SupplierReturnCreator", fields: [createdBy], references: [id])
  exporter                 User?                  @relation("SupplierReturnExporter", fields: [exportedById], references: [id])
  purchaseOrder            PurchaseOrder?         @relation(fields: [purchaseOrderId], references: [id])
  refundConfirmer          User?                  @relation("SupplierReturnRefundConfirmer", fields: [refundConfirmedBy], references: [id])
  supplier                 Supplier               @relation(fields: [supplierId], references: [id])

  @@index([supplierId])
  @@index([purchaseOrderId])
  @@index([branchId])
  @@index([status])
  @@map("supplier_returns")
}

model SupplierReturnDetail {
  id                  Int            @id @default(autoincrement())
  supplierReturnId    Int
  purchaseOrderId     Int?
  purchaseOrderCode   String?
  productId           Int
  productCode         String
  productName         String
  purchaseQuantity    Decimal        @default(0)
  purchasePrice       Decimal        @default(0)
  requestQuantity     Decimal
  confirmedQuantity   Decimal        @default(0)
  returnPrice         Decimal
  totalAmount         Decimal
  note                String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  conditionType       String         @default("normal")
  foreignReturnAmount Decimal?
  foreignReturnPrice  Decimal?
  inputMode           String         @default("unit_price")
  manufactureDate     DateTime?
  product             Product        @relation(fields: [productId], references: [id])
  purchaseOrder       PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  supplierReturn      SupplierReturn @relation(fields: [supplierReturnId], references: [id], onDelete: Cascade)

  @@index([supplierReturnId])
  @@index([purchaseOrderId])
  @@map("supplier_return_details")
}

model TradeMark {
  id           Int       @id @default(autoincrement())
  name         String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  kiotVietId   Int?      @unique @map("kiot_viet_id")
  lastSyncedAt DateTime? @map("last_synced_at")
  products     Product[]

  @@map("trade_marks")
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String
  type      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([type, name])
  @@index([type, name])
  @@map("categories")
}

model ProductVariant {
  id          Int       @id @default(autoincrement())
  name        String
  code        String    @unique
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@map("product_variants")
}

model Product {
  id                            Int                            @id @default(autoincrement())
  code                          String                         @unique
  name                          String
  fullName                      String?
  description                   String?
  orderTemplate                 String?
  parentName                    String?                        @map("parent_name")
  middleName                    String?                        @map("middle_name")
  childName                     String?                        @map("child_name")
  tradeMarkId                   Int?
  variantId                     Int?
  masterProductId               Int?
  masterUnitId                  Int?
